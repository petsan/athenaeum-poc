[Unit]
Description=llama.cpp GPU server -- Qwen3.8-27B Q4_K_M, pinned to GPU 0 (Athenaeum)
After=network.target

[Service]
Environment=CUDA_VISIBLE_DEVICES=0
ExecStart=/opt/llama.cpp/build/bin/llama-server --model /opt/models/Qwen3.8-27B-Q4_K_M.gguf --port 8080 --host 0.0.0.0 -c 262144 -np 2 --n-gpu-layers 999 --jinja --cache-type-k q8_0 --cache-type-v q8_0 --spec-type draft-mtp --spec-draft-model /opt/models/MTP/mtp-Qwen3.8-27B-Q4_0.gguf --spec-draft-n-max 3 --cache-ram 2048 --ctx-checkpoints 8
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
